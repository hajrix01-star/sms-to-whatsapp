<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bank Relay" android:textSize="28sp" android:textStyle="bold" />
    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الحالة: غير مفعّل" android:padding="12dp" android:layout_marginTop="16dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مرسلو البنوك المسموحون (بفاصلة)" android:layout_marginTop="16dp" />
    <EditText android:id="@+id/senderFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ALAHLI,AlRajhi" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="رابط Baseer Relay API" android:layout_marginTop="12dp" />
    <EditText android:id="@+id/apiUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="https://.../bank-sms" android:inputType="textUri" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مفتاح ربط الجهاز" android:layout_marginTop="12dp" />
    <EditText android:id="@+id/apiToken" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="يصدر من بصير" android:inputType="textPassword" />
    <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تفعيل التحويل" android:layout_marginTop="20dp" />
    <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="إيقاف التحويل" />
    <Button android:id="@+id/testButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="إرسال اختبار" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="لا يفتح واتساب ولا يرسل رموز التحقق." android:layout_marginTop="16dp" />
  </LinearLayout>
</ScrollView>
